               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredients      Purpose</content>
                  </paragraph>
                  <paragraph>Zinc Oxide 24.5%      Sunscreen            </paragraph>
               </text>
