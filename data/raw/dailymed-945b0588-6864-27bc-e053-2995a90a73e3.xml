               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive ingredients </title>
               <text>
                  <paragraph>water, alcohol denat. (24.5 %), glycerin, isoceteth-20, PEG-32, sodium citrate, fragrance, propylene glycol, dimethicone propyl PG-betaine, benozphenone-4, algae extract, aloe barbadenis leaf juice, blue 1</paragraph>
               </text>
               <effectiveTime value="20140613"/>
            </section>
