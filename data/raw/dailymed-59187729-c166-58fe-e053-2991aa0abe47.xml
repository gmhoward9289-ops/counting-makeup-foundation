               <component>
                  <section ID="id_link_41456cf0-d308-20b1-e054-00144ff88e88">
                     <id root="231c72e8-5345-757e-e063-6394a90ad266"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <text>
                        <paragraph>Sunscreen</paragraph>
                     </text>
                     <effectiveTime value="20240810"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="9d3a0fab-bcad-a218-e053-2a95a90a9819"/>
                     <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
                     <title>Uses</title>
                     <text>
                        <list listType="unordered" styleCode="Disc">
                           <item>helps prevent sunburn</item>
                           <item>if used as directed with other sun protection measures (see 
          
  
   
          
  
   <content styleCode="bold">
                                 <linkHtml href="#Directions">Directions</linkHtml>
                              </content>), decreases the risk of skin cancer and early skin aging caused by the sun
         
 
  
         
 
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20141119"/>
                  </section>
               </component>
            </section>
         </component>
