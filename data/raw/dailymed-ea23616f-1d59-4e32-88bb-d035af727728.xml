               <id root="49601063-c80c-bbdc-e063-6394a90a793c"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredients</content>
               </title>
               <text>
                  <paragraph>Homosalate 5%, Octocrylene 4.5%, Octisalate 4%, Avobenzone 3%</paragraph>
               </text>
               <effectiveTime value="20260124"/>
               <component>
                  <section ID="L0cd2b62d-7640-4d0d-8f96-9867f10910b7">
                     <id root="49601063-c80d-bbdc-e063-6394a90a793c"/>
