               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses:</title>
               <text>
                  <paragraph>Temporarily relieves minor skin irritations due to:</paragraph>
                  <list listType="unordered" ID="ic23b887b-9e28-4fbc-8ccb-2acf5ada4cbc">
                     <item>minor cuts</item>
                     <item>minor scrapes</item>
                     <item>insect bites<br/>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20241125"/>
            </section>
         </component>
         <component>
            <section>
               <id root="c3b980c9-6daa-4ff7-9cdf-bc9e2dc52d73"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">When using this product avoid contact with eyes<br/>
                     </content>
                  </paragraph>
               </text>
               <effectiveTime value="20241125"/>
            </section>
         </component>
         <component>
            <section>
               <id root="ae0e08c3-94b5-43d9-88d3-ae1db45f3b21"/>
               <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Stop use and ask doctor if condition worsens or<br/>symptoms persist for more than 7 days<br/>
                     </content>
                  </paragraph>
               </text>
               <effectiveTime value="20241125"/>
            </section>
         </component>
         <component>
            <section>
               <id root="fbf50ade-42f2-4dbd-a18b-6736357024a8"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children. If swallowed, get medical<br/>help or contact Poison Control Center right away.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20241125"/>
            </section>
         </component>
         <component>
            <section>
               <id root="df8283a0-aa69-4a47-8a9a-ae0e96c65d0b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions:</title>
               <text>
                  <list listType="unordered" styleCode="square">
                     <item>Remove protective inner seal</item>
                     <item>Moisten cotton ball or cleansing pad and gently wipe skin</item>
                     <item>Apply as often as necessary</item>
                  </list>
               </text>
               <effectiveTime value="20241125"/>
            </section>
