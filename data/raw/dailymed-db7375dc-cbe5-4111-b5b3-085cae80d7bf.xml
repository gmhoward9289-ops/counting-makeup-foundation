                     <id root="d2ebe7aa-bdd7-40ac-8814-367915e2af22"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Keep out of reach of children.</content>
                        </paragraph>
                        <paragraph>If product is swallowed, get medical help or contact a Poison Control Center immediately.</paragraph>
