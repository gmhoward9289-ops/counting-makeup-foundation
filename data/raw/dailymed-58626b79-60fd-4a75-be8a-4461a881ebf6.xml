               <id root="f94102eb-1d09-4e0e-a8a0-8d3da46949c4"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Warnings</content>
                     </content>
                     <br/>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20130329"/>
               <component>
                  <section ID="L020d7fda-9da8-49d6-9082-067e9516bb06">
                     <id root="80230b67-b671-4357-af88-7e2b539cacd2"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Do not use</content> on damaged or broken skin</paragraph>
                     </text>
                     <effectiveTime value="20130329"/>
                     <component>
                        <section ID="Lcf705fda-4575-433b-9905-2a3bb0acc68e">
                           <id root="bb9950de-71c0-4dda-92f5-5f3c81267070"/>
                           <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                           <text>
                              <paragraph>
                                 <content styleCode="bold">When using this product</content> keep out of eyes. Rinse with water to remove.</paragraph>
                           </text>
                           <effectiveTime value="20130329"/>
                           <component>
                              <section ID="L4390e10f-eda2-4e3b-bf36-ef7a5e367ae9">
                                 <id root="c8d1d625-9757-4614-8dcf-8f03a6e1e2b7"/>
                                 <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                                 <text>
                                    <paragraph>
                                       <content styleCode="bold">Stop use and ask a doctor if</content> rash occurs</paragraph>
                                 </text>
                                 <effectiveTime value="20130329"/>
                                 <component>
                                    <section ID="Lc43c666c-76ae-420f-87d8-c98f3cf3a561">
                                       <id root="4b5dc8ca-b09d-4918-9882-d73929106006"/>
                                       <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                                       <text>
                                          <paragraph>
                                             <content styleCode="bold">Keep out of reach of children.</content> If swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
                                       </text>
                                       <effectiveTime value="20130329"/>
                                    </section>
                                 </component>
                              </section>
                           </component>
                        </section>
                     </component>
                  </section>
