         <component>
            <section ID="id_link_780de3e2-0701-0bf1-e053-2991aa0a1c1f">
               <id root="780f7483-6ef8-6a8b-e053-2991aa0aacff"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Directions &amp; Uses</title>
               <text>
                  <paragraph>Apply generously 15 minutes before sun exposure.</paragraph>
                  <paragraph>Reapply immediately after towel drying.</paragraph>
                  <paragraph>Reapply at least every 2 hours.</paragraph>
                  <paragraph>Helps prevent sunburn.</paragraph>
                  <paragraph>If used as directed with other sun protection measures decreases the risk of skin cancer and early skin aging caused by the sun.</paragraph>
               </text>
               <effectiveTime value="20181012"/>
            </section>
         </component>
