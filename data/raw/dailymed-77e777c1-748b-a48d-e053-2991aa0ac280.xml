            <section ID="id_link_780de3e2-06fb-0bf1-e053-2991aa0a1c1f">
               <id root="780f733c-ec19-b9a2-e053-2a91aa0a2f8d"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <paragraph>Apply generously 15 minutes before sun exposure.</paragraph>
                  <paragraph>Reapply immediately after towel drying.</paragraph>
                  <paragraph>Reapply at least every 2 hours.</paragraph>
               </text>
               <effectiveTime value="20181012"/>
            </section>
