               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive ingredients</title>
               <text>
                  <paragraph>Polymethylsilsesquioxane, Silica, Jojoba Esters, Alumina, Oryza Sativa (Rice) Extract, Caprylyl Glycol, Phenoxyethanol, Hexylene Glycol, Aluminum Dimyristate, Triethoxycaprylylsilane, Disodium Stearoyl Glutamate, Iron Oxides, Mica.</paragraph>
               </text>
               <effectiveTime value="20181012"/>
