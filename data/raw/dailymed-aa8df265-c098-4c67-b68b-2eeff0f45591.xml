               <id root="264213ec-47a3-ee9d-e063-6294a90a1865"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>Warning:</paragraph>
                  <paragraph>For external use only</paragraph>
                  <paragraph>Skin Cancer/ Skin Aging Alert:</paragraph>
                  <paragraph>Spending time in the sun increases your increases your risk of sking cancer or early skin aging. This product has been shown only to help prevent sunburn not sking cancer or skin aging.</paragraph>
               </text>
               <effectiveTime value="20170811"/>
            </section>
         </component>
         <component>
            <section>
