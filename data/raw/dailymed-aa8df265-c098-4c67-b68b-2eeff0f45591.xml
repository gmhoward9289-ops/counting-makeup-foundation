               <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
               <text>
                  <paragraph>When using this product:</paragraph>
                  <paragraph>Keep out of eyes. Rinse with water to remove. 
  <br/>
                  </paragraph>
               </text>
               <effectiveTime value="20170811"/>
            </section>
