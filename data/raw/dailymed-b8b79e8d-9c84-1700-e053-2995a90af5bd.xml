         <component>
            <section ID="id_link_f5792ffe-ab56-1a1e-e053-2995a90a21ce">
               <id root="f5792ffe-ab55-1a1e-e053-2995a90a21ce"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>Use for relief of minor skin irritations due to </paragraph>
                  <list listType="unordered">
                     <item>Insect bites</item>
                     <item>minor cuts</item>
                     <item>minor scrapes</item>
                  </list>
               </text>
               <effectiveTime value="20230224"/>
            </section>
         </component>
         <component>
