               <id root="f5792ffe-ab57-1a1e-e053-2995a90a21ce"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">For External use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20230224"/>
               <component>
                  <section ID="id_link_f5792ffe-ab5a-1a1e-e053-2995a90a21ce">
                     <id root="f5792ffe-ab59-1a1e-e053-2995a90a21ce"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <text>
                        <paragraph>Avoid contact with eyes. If contact occurs, rinse thoroughly with water</paragraph>
                     </text>
                     <effectiveTime value="20230224"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_f57924bb-94f9-fe82-e053-2a95a90af55a">
                     <id root="f57924bb-94f8-fe82-e053-2a95a90af55a"/>
                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Stop use and ask a doctor if</content>
                        </paragraph>
                        <list listType="unordered">
                           <item>condition worsens or symptoms last for more than 7 days</item>
                        </list>
                     </text>
                     <effectiveTime value="20230224"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_f57942cc-cbca-5d5e-e053-2a95a90acdec">
                     <id root="f57942cc-cbc9-5d5e-e053-2a95a90acdec"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>If swallowed, get medical help or contact a Poison Control right away</paragraph>
                     </text>
                     <effectiveTime value="20230224"/>
                  </section>
               </component>
            </section>
