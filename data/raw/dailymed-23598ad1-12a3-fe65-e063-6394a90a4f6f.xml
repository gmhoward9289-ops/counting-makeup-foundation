               <id root="c6b81eb9-3a1f-bfd0-e053-2a95a90a149f"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Purpose</content>
                  </content>
               </title>
               <text>
                  <paragraph>Sunscreen</paragraph>
               </text>
               <effectiveTime value="20200309"/>
            </section>
         </component>
         <component>
            <section ID="L0f26b960-1514-430e-86be-db4f04539d1b">
               <id root="c6b81eb9-3a20-bfd0-e053-2a95a90a149f"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Uses</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>helps prevent sunburn</item>
                     <item>if used as directed with other sun protection measures (see 
        
  
   <content styleCode="italics">
                           <content styleCode="bold">﻿Directions</content>
                        </content>﻿), decreases the risk of skin cancer and early skin aging caused by the sun
       
 
  </item>
                  </list>
               </text>
               <effectiveTime value="20200309"/>
            </section>
         </component>
         <component>
