               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <list listType="unordered">
                     <item>Helps prevent and temporarily protects chafed, chapped or cracked skin</item>
                     <item>Helps prevent and protect from the drying effects of wind and cold weather</item>
                  </list>
               </text>
               <effectiveTime value="20220415"/>
            </section>
