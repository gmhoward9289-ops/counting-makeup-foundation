               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Other information</content>
                     </content>
                  </paragraph>
                  <paragraph>protect the product in this container from excessive heat and direct sun</paragraph>
               </text>
               <effectiveTime value="20150220"/>
            </section>
         </component>
