               <id root="d5fcebab-afee-4d43-beb5-53b171a56372"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Astringent</paragraph>
               </text>
               <effectiveTime value="20260204"/>
            </section>
         </component>
         <component>
            <section ID="LINK_64cc29fb-7b66-4f60-ab9f-7b8ac7265e7e">
               <id root="cc80eec1-0a46-4159-b211-d7f01806af04"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <paragraph>Relieves minor skin irritation due to:  </paragraph>
                  <list listType="unordered" styleCode="Disk">
                     <item>insect bites</item>
                     <item>minor cuts</item>
                     <item>minor scrapes</item>
                  </list>
               </text>
               <effectiveTime value="20260204"/>
            </section>
         </component>
         <component>
            <section ID="LINK_0ca3e7ae-6d02-4123-9214-26408e8ea236">
               <id root="fe580165-e18a-43c2-9116-211df594ab51"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only.</content>
                  </paragraph>
                  <list listType="unordered" styleCode="Disk">
                     <item>Avoid swallowing.</item>
                  </list>
               </text>
               <effectiveTime value="20260204"/>
               <component>
                  <section ID="LINK_519d5251-cecf-46fe-ab4e-f095ece2dc19">
                     <id root="8f255498-777e-4be8-9d1a-e96a4cd48121"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product</title>
                     <text>
                        <paragraph>avoid contact with eyes. If contact occurs, rinse thoroughly with water.</paragraph>
                     </text>
                     <effectiveTime value="20260204"/>
                  </section>
               </component>
               <component>
                  <section ID="LINK_429e85bd-b427-4379-a5b5-f4b6ed4385a2">
                     <id root="da5045b5-8354-4da4-a8b1-cbc02bfec552"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <paragraph>condition worsens or symptoms persist for more than 7 days</paragraph>
                     </text>
                     <effectiveTime value="20260204"/>
                  </section>
               </component>
               <component>
                  <section ID="LINK_b784c861-fcf0-47d6-b115-874f72012944">
                     <id root="aad295d6-0e8e-4632-a72f-f735211f22bc"/>
                     <code code="53414-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PREGNANCY OR BREAST FEEDING SECTION"/>
                     <title>If pregnant or breast-feeding,</title>
                     <text>
                        <paragraph>ask a health professional before use.</paragraph>
                     </text>
                     <effectiveTime value="20260204"/>
                  </section>
               </component>
               <component>
                  <section ID="LINK_48c8f718-ff0b-4574-ba11-0ca4c1086ab1">
                     <id root="c55cd8c9-7dc9-49b1-b8d7-4fc48dc91b6d"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>Keep out of reach of children.</title>
                     <text>
                        <paragraph>If swallowed, get medical help or contact a Poison Control Center (1-800-222-1222) right away.</paragraph>
                     </text>
                     <effectiveTime value="20260204"/>
                  </section>
               </component>
            </section>
