               <id root="546090ce-c42a-bc59-e063-6294a90af20f"/>
               <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
               <title>When using this product</title>
               <text>
                  <paragraph>keep out of eyes. Rinse with water to remove.</paragraph>
               </text>
               <effectiveTime value="20260615"/>
            </section>
         </component>
