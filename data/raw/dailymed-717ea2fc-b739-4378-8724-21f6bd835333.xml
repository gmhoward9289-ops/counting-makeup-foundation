               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <text>
                  <paragraph>Keep out of reach of children</paragraph>
               </text>
               <effectiveTime value="20170113"/>
            </section>
         </component>
         <component>
            <section ID="L5416f724-4afc-4b32-bf1e-37c96c494e74">
               <id root="745b9cef-9eb9-4383-9193-fed4eb7d186c"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>Stop use and ask a doctor if rash occurs</paragraph>
               </text>
               <effectiveTime value="20170113"/>
            </section>
         </component>
         <component>
            <section ID="L5a532a19-4269-425d-aec4-178b6646a3b6">
               <id root="bbf416b8-fc06-4d7c-a10f-f0d07f665a44"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Warnings</content> For external use only </paragraph>
                  <paragraph>Do not on damaged or broken skin</paragraph>
                  <paragraph>When using this product keep out of eyes</paragraph>
                  <paragraph>Rinse with water to remove</paragraph>
                  <paragraph>If swallowed, get medical help or contact a Poison Center right away</paragraph>
               </text>
               <effectiveTime value="20170113"/>
            </section>
         </component>
         <component>
            <section ID="Lbb4861a4-b75c-4123-b789-b512f989f5c7">
               <id root="0687665c-b449-4115-bf20-4fd9c3b8aedd"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Directions </content>​Apply liberally and evenly to face before sun exposure </paragraph>
                  <paragraph>Reapply after 40 minutes of swimming or sweating </paragraph>
                  <paragraph>immediately after towel drying</paragraph>
                  <paragraph>at least every 2 hours</paragraph>
                  <paragraph>Children under 6 months: Ask a doctor</paragraph>
               </text>
               <effectiveTime value="20170113"/>
            </section>
         </component>
         <component>
