               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only.</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Flammable: Keep away from fire or flame.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20201109"/>
               <component>
                  <section>
                     <id root="b7201a71-141d-18f9-e053-2995a90a7c6d"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product</title>
                     <text>
                        <list listType="unordered">
                           <item>skin irritation and dryness is more likely to occur if you use another topical acne medication at the same time. If irritation occurs, only use one topical acne medication at a time.</item>
                           <item>If eye contact occurs, flush thoroughly with water.</item>
                        </list>
                     </text>
                     <effectiveTime value="20201109"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="b7201a71-141e-18f9-e053-2995a90a7c6d"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Keep out of reach of children.</content> If swallowed, get medical help or contact a Poison Control Center right away.
        

 </paragraph>
                     </text>
                     <effectiveTime value="20201109"/>
                  </section>
