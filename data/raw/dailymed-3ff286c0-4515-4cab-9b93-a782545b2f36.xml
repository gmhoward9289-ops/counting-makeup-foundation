               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <paragraph>protect the product in this container from excessive heat and direct sun</paragraph>
               </text>
               <effectiveTime value="20260527"/>
            </section>
         </component>
