               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Drug Facts</title>
               <text>
                  <paragraph>Drug Facts enclosed</paragraph>
               </text>
               <effectiveTime value="20260303"/>
            </section>
